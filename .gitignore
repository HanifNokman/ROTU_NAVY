# Ignore everything else first
*.log
.DS_Store
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
Homestead.json
Homestead.yaml
Thumbs.db

# Track .gitignore itself
!.gitignore

# Track public/assets folder and all its contents
!public/
!public/assets/
!public/assets/**

# Track private folder and all its contents
!private/
!private/**
